---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'The destination for GTM Engineers and Revenue Operators.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Ops Underground</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@400;500&family=Instrument+Sans:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --black: #0a0a08;
        --white: #f0ede6;
        --green: #3b8c4a;
        --green-light: #4aaa5c;
        --surface: #111110;
        --border: rgba(255,255,255,0.07);
        --muted: rgba(240,237,230,0.45);
        --font-serif: 'DM Serif Display', serif;
        --font-mono: 'DM Mono', monospace;
        --font-sans: 'Instrument Sans', sans-serif;
      }

      html { background: var(--black); color: var(--white); font-family: var(--font-sans); }
      body { min-height: 100vh; }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; display: block; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
