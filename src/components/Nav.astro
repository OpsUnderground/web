---
const currentPath = Astro.url.pathname;
---
<nav>
  <a href="/" class="logo">
    <svg width="28" height="28" viewBox="0 0 32 32" fill="none">
      <circle cx="16" cy="16" r="15" stroke="#f0ede6" stroke-width="1.5"/>
      <path d="M16 8 L16 20 M11 15 L16 21 L21 15" stroke="#3b8c4a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span>Ops Underground</span>
  </a>
  <div class="links">
    <a href="/articles" class={currentPath.startsWith('/articles') ? 'active' : ''}>Articles</a>
    <a href="/roundtables" class={currentPath.startsWith('/roundtables') ? 'active' : ''}>Roundtables</a>
    <a href="/about" class={currentPath.startsWith('/about') ? 'active' : ''}>About</a>
    <a href="/subscribe" class="cta">Subscribe</a>
  </div>
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 2.5rem;
    border-bottom: 0.5px solid var(--border);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--white);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .links a {
    font-size: 13px;
    color: var(--muted);
    letter-spacing: 0.03em;
    transition: color 0.2s;
  }

  .links a:hover, .links a.active { color: var(--white); }

  .links .cta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--green);
    border: 0.5px solid var(--green);
    padding: 6px 16px;
    border-radius: 2px;
    transition: background 0.2s, color 0.2s;
  }

  .links .cta:hover {
    background: var(--green);
    color: var(--black);
  }

  @media (max-width: 600px) {
    nav { padding: 1.25rem 1.25rem; }
    .links a:not(.cta) { display: none; }
  }
</style>
